{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,

    /*
     * `strict` is off deliberately. The app predates this config and leans on
     * implicit `any` in a lot of places; turning it on would produce hundreds of
     * errors and make the gate useless. This setup catches the mistakes that
     * actually break things - wrong prop types, bad imports, misused APIs -
     * without demanding a repo-wide rewrite first. Tighten incrementally.
     */
    "strict": false,
    "noUnusedLocals": false,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,

    /* `node` is needed for vite.config.ts, which uses __dirname and `path`. */
    "types": ["vite/client", "node"],
    "paths": { "@/*": ["./src/*"] }
  },
  "include": ["src", "vite.config.ts"],
  "exclude": ["node_modules", "dist"]
}
