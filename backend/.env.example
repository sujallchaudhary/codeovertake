PORT=5000
MONGODB_URI=mongodb://localhost:27017/compare
GITHUB_TOKEN=
# Cron schedule: default is 12:00 AM IST daily
CRON_SCHEDULE=30 18 * * *
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
NSUT_API_URL=https://api.sujal.info/api/nsut

# --- Auth: Clerk ---
# Accounts are managed entirely by Clerk. Enable Google, GitHub and any other
# social provider from the Clerk Dashboard (User & Authentication > Social
# Connections) - no code change is needed to add a provider.
#
# Required. Backend API key, also used to fetch JWKS and OAuth access tokens.
CLERK_SECRET_KEY=sk_test_xxx
# Optional but recommended: the instance's PEM public key from
# Clerk Dashboard > Configure > API keys > Show JWT public key.
# Supplying it makes session-token verification networkless (no JWKS round trip).
CLERK_JWT_KEY=
# Signing secret from the Clerk Dashboard webhook endpoint. Without it the
# webhook route refuses every request rather than trusting unsigned payloads.
CLERK_WEBHOOK_SECRET=whsec_xxx

# --- Claiming a leaderboard profile ---
# Optional. When set, a Clerk-verified email on this domain can be used as
# proof of identity when claiming a roll number (in addition to the default
# path of verifying a coding platform handle already on the record).
# Leave blank to disable the email path entirely.
INSTITUTE_EMAIL_DOMAIN=

# --- Contest tracker sync (default: every 6 hours) ---
CONTEST_CRON_SCHEDULE=0 */6 * * *

# --- Admin ---
# Shared secret for the `x-admin-secret` header. Only for scripts, cron and CI,
# which have no session. Actions taken this way are audited as "secret" and are
# therefore unattributable — prefer a real admin account for anything manual.
ADMIN_SECRET=

# Comma-separated emails that are granted admin on sign-in. This is the bootstrap
# path: the first admin has to come from somewhere. Only *Clerk-verified*
# addresses count, so adding someone else's email to your own Clerk account is
# not enough to self-promote. Removing an email here revokes access on their next
# sync, unless they were also promoted manually from the panel.
#
# You can equally set `{"role":"admin"}` in a user's Clerk public metadata.
ADMIN_EMAILS=
