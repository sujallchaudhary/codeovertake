PORT=5000
MONGODB_URI=mongodb://localhost:27017/compare
GITHUB_TOKEN=
# Cron schedule: default is 12:00 AM IST daily
CRON_SCHEDULE=30 18 * * *
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
NSUT_API_URL=https://api.sujal.info/api/nsut

# --- Auth (Codolio-style accounts) ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=30d

# --- GitHub OAuth (Development Stats / SSO) ---
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=http://localhost:5173/auth/github/callback

# --- Contest tracker sync (default: every 6 hours) ---
CONTEST_CRON_SCHEDULE=0 */6 * * *
